<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/liturgical_wine_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_save_title"
            android:textColor="@color/gold_bright"
            android:textSize="22sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:background="@color/gold_border"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp" />

        <!-- Count Highlight Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/border_gold"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_dialog_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Недеља, 24.10.2026."
                    android:textColor="@color/parchment_muted"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/communicants_label"
                    android:textColor="@color/gold_bright"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_dialog_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/gold_bright"
                android:textSize="48sp"
                android:textStyle="bold"
                android:layout_marginLeft="16dp" />
        </LinearLayout>

        <!-- Quick Presets -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_quick_presets"
            android:textColor="@color/gold_bright"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_preset_sunday"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginRight="6dp"
                android:background="@drawable/btn_undo"
                android:text="Недељна"
                android:textColor="@color/parchment"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_preset_feast"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginRight="6dp"
                android:background="@drawable/btn_undo"
                android:text="Празнична"
                android:textColor="@color/parchment"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_preset_slava"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginRight="6dp"
                android:background="@drawable/btn_undo"
                android:text="Св. Тројица"
                android:textColor="@color/gold_bright"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_preset_presanctified"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/btn_undo"
                android:text="Пређеосвећена"
                android:textColor="@color/parchment"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Feast Title Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_feast"
            android:textColor="@color/parchment_muted"
            android:textSize="14sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_feast_name"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/border_gold"
            android:textColor="@color/parchment"
            android:textColorHint="@color/parchment_dim"
            android:hint="Унесите или изаберите назив"
            android:padding="12dp"
            android:textSize="16sp" />

        <!-- Celebrant / Notes Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_notes"
            android:textColor="@color/parchment_muted"
            android:textSize="14sp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_notes"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@drawable/border_gold"
            android:textColor="@color/parchment"
            android:textColorHint="@color/parchment_dim"
            android:hint="@string/label_hint_notes"
            android:gravity="top|left"
            android:padding="12dp"
            android:textSize="15sp" />

        <!-- Dialog Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:gravity="right">

            <Button
                android:id="@+id/btn_cancel_entry"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:minWidth="100dp"
                android:background="@drawable/btn_undo"
                android:text="@string/btn_cancel"
                android:textColor="@color/parchment_dim"
                android:textSize="16sp"
                android:layout_marginRight="12dp" />

            <Button
                android:id="@+id/btn_save_entry"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:minWidth="180dp"
                android:background="@drawable/btn_gold"
                android:text="@string/btn_save"
                android:textColor="@color/liturgical_burgundy"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
